---
import H1 from "../components/h1.astro";
import InfoLayout from "../layouts/InfoLayout.astro";
import TranslateText from "../components/TranslateText";
---

<InfoLayout>
  <div class="p-4 sm:pt-8 sm:px-12 pb-20 min-h-dvh flex flex-col justify-between gap-32">
    <div class="space-y-4 sm:space-y-12">
      <H1>
        <TranslateText pt="Conheça Luiza LeBlanc" en="Meet Luiza LeBlanc" client:load />
      </H1>

      <div class="space-y-4 sm:space-y-6 text-xl xl:text-2xl text-zinc-500 text-balance">
        <p>
          <TranslateText
            pt="Engenheira Full Stack Java com experiência no desenvolvimento de aplicações web e sistemas distribuídos de ponta a ponta, com foco em arquitetura monolítica, APIs REST e integração entre front-end e back-end."
            en="Full Stack Java Engineer with experience developing end-to-end web applications and distributed systems, focused on monolithic architecture, REST APIs, and front-end/back-end integration."
            client:load
          />
        </p>
        <p>
          <TranslateText
            pt="Especialização em Java e Spring Boot, atuando na construção de microsserviços, autenticação, mensageria com RabbitMQ, persistência com Spring Data JPA/Hibernate e modelagem de bancos relacionais (MySQL)."
            en="Specialization in Java and Spring Boot, working on microservices, authentication, messaging with RabbitMQ, persistence with Spring Data JPA/Hibernate, and relational database modeling (MySQL)."
            client:load
          />
        </p>
        <p>
          <TranslateText
            pt="No front-end, desenvolvimento de interfaces modernas com React, Next.js, Angular, TypeScript, ecossistema JavaScript e Tailwind CSS, incluindo produção de Design Systems, integração com APIs e experiências responsivas."
            en="On the front-end, development of modern interfaces with React, Next.js, Angular, TypeScript, the JavaScript ecosystem, and Tailwind CSS, including building Design Systems, API integration, and responsive experiences."
            client:load
          />
        </p>
        <p>
          <TranslateText
            pt="Experiência complementar em infraestrutura e DevOps utilizando AWS, Docker, Kubernetes e CI/CD, além de versionamento com Git/GitHub, ambiente Linux e prototipação no Figma."
            en="Complementary experience in infrastructure and DevOps using AWS, Docker, Kubernetes, and CI/CD, along with version control with Git/GitHub, Linux environments, and prototyping in Figma."
            client:load
          />
        </p>
        <p>
          <TranslateText
            pt="Atuação em equipes ágeis, aplicando Clean Code, SOLID, Design Patterns e princípios de arquitetura para entregar soluções escaláveis, performáticas e de alta qualidade."
            en="Work within agile teams, applying Clean Code, SOLID, Design Patterns, and architectural principles to deliver scalable, high-performing, high-quality solutions."
            client:load
          />
        </p>
      </div>
    </div>

    <div class="space-y-2 text-base sm:text-lg">
      <h2 class="px-4 text-zinc-400 underline underline-offset-4 decoration-zinc-500">
        <TranslateText pt="Conquistas Relevantes" en="Relevant Achievements" client:load />
      </h2>

      <ul class="px-4 text-zinc-400 list-disc list-outside">
        <li>
          <TranslateText
            pt="Engenharia Full-Stack - Kenzie Academy (2023-2024)"
            en="Full-Stack Engineering - Kenzie Academy (2023-2024)"
            client:load
          />
        </li>
        <li>
          <TranslateText
            pt="CC50 - Universidade de Harvard (2025)"
            en="CS50 - Harvard University (2025)"
            client:load
          />
        </li>
        <li>
          <TranslateText
            pt="Bootcamp AI Java Backend (2026)"
            en="AI Java Backend Bootcamp (2026)"
            client:load
          />
        </li>
      </ul>

      <a
        href="https://www.linkedin.com/in/luiza-ferraz-leblanc/details/certifications/"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-block w-fit text-base sm:text-lg px-5 py-2 rounded-full transition-all duration-300 ease-in-out whitespace-nowrap text-zinc-100 hover:text-white bg-transparent hover:bg-zinc-100/20 hover:outline-2 outline-offset-2 outline-zinc-100/20"
      >
        <TranslateText pt="Ver Certificações" en="View Certifications" client:load />
      </a>
    </div>
  </div>
</InfoLayout>
