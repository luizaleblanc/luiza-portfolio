---
import H1 from "../components/h1.astro";
import InfoLayout from "../layouts/InfoLayout.astro";
import ProjectsList from "../components/ProjectsList";

import HealthCareImg from "../assets/healthcare.png";
import OrganizaAI from "../assets/organiza-ia.png";
import StartCRM from "../assets/start-crm.png";

const projectsData = [
  {
    title: "HealthCare",
    descriptionEn:
      "Automated ETL pipeline for extracting data from the ANS and an interactive dashboard focused on analyzing health insurance operators' expenses. It uses Python for data extraction and transformation, MySQL as the database, Vue.js for building the dashboard, and Docker for containerization.",
    descriptionPt:
      "Pipeline ETL automatizado para extração de dados da ANS e um dashboard interativo focado em analisar as despesas das operadoras de saúde. Utiliza Python para a extração e transformação dos dados, MySql como base de dados, Vue.js para a construção do dashboard e Docker para containerização.",
    imageSrc: HealthCareImg.src,
    link: "https://github.com/luizaleblanc/intuitive_care",
  },
  {
    title: "Organiza AI",
    descriptionEn:
      "Organiza AI is a full-stack application for personal finance management with Artificial Intelligence, built with Java, Spring Boot, Spring AI, and Next.js. The platform uses voice commands and Natural Language Processing (NLP) to interpret requests, execute financial transactions, and provide audio responses, in addition to offering authentication and a financial dashboard.",
    descriptionPt:
      "Organiza AI é uma aplicação full-stack para gestão de finanças pessoais com Inteligência Artificial, desenvolvida com Java, Spring Boot, Spring AI e Next.js. A plataforma utiliza comandos de voz e Processamento de Linguagem Natural (NLP) para interpretar solicitações, executar transações financeiras e fornecer respostas em áudio, além de oferecer autenticação e dashboard financeiro.",
    imageSrc: OrganizaAI.src,
    link: "https://github.com/luizaleblanc/organiza-ai",
  },
  {
    title: "StartCRM",
    descriptionEn:
      "Technical leadership, front-end architecture, UX, and MVP development for Start CRM, using Next.js 16, TypeScript, and Tailwind CSS. Implementation of a proprietary Design System, integrated BFF, authentication, dashboards, Leads Kanban, and Business Pipeline, with an architecture ready for seamless integration with a real back-end. SPA published on Vercel, focused on scalability, maintainability, and user experience.",
    descriptionPt:
      "Liderança técnica, arquitetura de front-end, UX e desenvolvimento do MVP do Start CRM, utilizando Next.js 16, TypeScript e Tailwind CSS. Implementação de Design System proprietário, BFF integrado, autenticação, dashboards, Kanban de Leads e Pipeline de Negócios, com arquitetura preparada para integração transparente com back-end real. Publicação da SPA no Vercel, com foco em escalabilidade, manutenção e experiência do usuário.",
    imageSrc: StartCRM.src,
    link: "https://github.com/luizaleblanc/start-crm",
    badge: "In Production",
  },
];
---

<InfoLayout>
  <div
    class="flex flex-col items-center justify-center min-h-screen py-20 px-4 sm:px-12 bg-zinc-900"
  >
    <H1>Projetos</H1>
    <div class="mt-12 w-full max-w-6xl">
      <ProjectsList client:load projects={projectsData} />
    </div>
  </div>
</InfoLayout>
